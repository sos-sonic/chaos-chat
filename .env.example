# Supabase values for the C chat server. Copy this file to .env and replace
# the placeholders. Do not commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Fetch this from the same project after configuring its asymmetric ES256 JWT
# signing key: https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS='{"keys":[PASTE_THE_COMPLETE_JWKS_JSON_HERE]}'

# This must exactly match the browser address served by scripts/dev.sh.
# One exact origin, or a comma-separated allowlist for a local/LAN demo.
CHAT_ALLOWED_ORIGIN=http://localhost:3000

# Local inference (WSL2 / 6 GB GPU-friendly defaults). Set START_VLLM=1 to
# use vLLM, or START_LOCAL_LLM=1 for the bundled Transformers fallback.
START_VLLM=0
START_LOCAL_LLM=0
VLLM_WSL2_ENABLE_PIN_MEMORY=1
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=4096
VLLM_ENFORCE_EAGER=1
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
HF_HUB_DISABLE_XET=1
# Set this only when diagnostics show FlashAttention is the blocker:
# VLLM_ATTENTION_BACKEND=TRITON_ATTN
