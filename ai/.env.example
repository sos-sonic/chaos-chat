# Redis channel used by chat_server.c
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHANNEL=chat:messages

# vLLM's OpenAI-compatible chat-completions server.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_API_KEY=local-chat

# Optional, separate embedding server. Without it, the sidecar uses a bounded
# lexical retrieval fallback so classification and the bot remain testable.
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_API_KEY=local-chat

RAG_HISTORY_LIMIT=200
RAG_RETRIEVAL_COUNT=6
RAG_TRIGGER_EVERY=3
RAG_COOLDOWN_SECONDS=25
RAG_BOT_ENABLED=true

# Vibe Bot sees the latest bounded room window and only auto-replies when a
# strong sentiment is detected. /vibe, @vibe, and @intervener always trigger.
VIBE_CONTEXT_LIMIT=30
VIBE_SENTIMENT_THRESHOLD=0.65
VIBE_BOT_NAME='Vibe Bot'
# Optional additional display names that should provide context but never make
# Vibe Bot auto-comment. The built-in local demo bots are ignored by default.
VIBE_IGNORED_USERS=
